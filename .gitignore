# Caprebate test repository — an ALLOW-LIST. Everything is ignored except the code the
# application and its test suites need. Governance documents, board exports, backups
# and anything that could hold real client data are never committed.
/*
!/.gitignore
!/.gitattributes
!/.vercelignore
!/.devcontainer/
!/README.md
!/api/
!/vercel.json
!/package.json
!/Caprebate site.html
!/Caprebate/
/Caprebate/*
!/Caprebate/09-app/
!/Caprebate/03-app/
!/Caprebate/02-modules-and-build-prep/
/Caprebate/02-modules-and-build-prep/*
!/Caprebate/02-modules-and-build-prep/Module-0*-*.md
!/Caprebate/02-modules-and-build-prep/Caprebate-Fixture-Taxonomy-v1.csv
!/Caprebate/04-phase-work/
/Caprebate/04-phase-work/*
!/Caprebate/04-phase-work/phase3/
!/Caprebate/04-phase-work/phase9/
!/Caprebate/06-commercial-and-governance/
/Caprebate/06-commercial-and-governance/*
!/Caprebate/06-commercial-and-governance/Caprebate Engagement Letter.docx
# Phase 151d, 25 Sep 2026: monday.com was dropped, so the plan, the phase history, the three
# sign-off registers, the tracker (the old board) and the claim lock are files, committed here.
# .vercelignore keeps this folder OUT of the test deploy, which serves committed files publicly.
!/Caprebate/00-START-HERE/
/Caprebate/00-START-HERE/*
!/Caprebate/00-START-HERE/hub/
!/Caprebate/00-START-HERE/hub/*.md
!/Caprebate/00-START-HERE/hub/*.csv
!/Caprebate/00-START-HERE/hub/*.txt

# never, anywhere
*.bak*
*.orig-fragmented
*.pre-132b
.DS_Store
node_modules/
dist/
*.db
*.db-*
*.sqlite
.documents/
/Caprebate/03-app/signoff-snapshot/
.env
.env.*
.tmp*/

# Phase 146b: keys and certificates, anywhere in the tree. The key file lives OUTSIDE the repository
# (~/.caprebate-secrets.env) and src/secrets.ts refuses one inside it; these lines stop a copy dropped
# into the tree from being committed. The example, which holds names and no values, is the one exception.
*.env
*secret*
*.p12
*.pfx
*.pem
*.key
!/Caprebate/09-app/backend/secrets.example.env
!/Caprebate/09-app/backend/src/secrets.ts
