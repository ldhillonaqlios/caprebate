{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --omit=dev",
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{Caprebate site.html,Caprebate/**,node_modules/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
