{
  "name": "@caprebate/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Caprebate back end: authentication, six application roles, server-side authorisation, and an append-only audit log. One process, both applications.",
  "license": "UNLICENSED",
  "scripts": {
    "migrate": "node src/cli.ts migrate",
    "seed": "CAPREBATE_ALLOW_SEED=1 node src/cli.ts seed",
    "verify-audit": "node src/cli.ts verify-audit",
    "start": "node src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "node tools/typecheck.cjs",
    "lint:sql": "node tools/lint-sql.cjs",
    "lint:paths": "node tools/lint-paths.cjs",
    "audit:live": "npm audit --omit=dev --audit-level=high",
    "check": "npm run audit:live && npm run lint:sql && npm run lint:paths && npm run typecheck && npm run test",
    "start:demo": "node tools/demo-server.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@node-rs/argon2": "^2.2.2",
    "libsql": "^0.5.29",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vercel/blob": "^2.8.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
