# Caprebate — the key file. EXAMPLE ONLY: names, never values.
#
# Copy this to ~/.caprebate-secrets.env (or the path in CAPREBATE_SECRETS), OUTSIDE the code folder, and fill in
# only the keys you have. The back end refuses a key file inside the code folder. Keep it readable by you alone:
#   chmod 600 ~/.caprebate-secrets.env
# A name left empty means that service is not set up; its facts stay as questions. Nothing breaks.
# Every connector is also switched off in the code until someone decides to turn it on — a key alone turns
# nothing on. src/secrets.ts lists who may read each name; a test checks this file against that list.

# Client documents read by the Claude API (Phase 146e)
ANTHROPIC_API_KEY=

# Companies House public data API — the key is the Basic authentication user name (Phase 146c)
COMPANIES_HOUSE_API_KEY=

# CQC API — sent as the Ocp-Apim-Subscription-Key header (Phase 146c)
CQC_SUBSCRIPTION_KEY=

# Energy certificates — the bearer token from your account page on
# get-energy-performance-data.communities.gov.uk (GOV.UK One Login). One token; no e-mail is needed (Phase 146c)
EPC_API_TOKEN=

# Homedata address lookup (Phase 146d)
HOMEDATA_API_KEY=

# HM Land Registry's title register is looked up BY HAND since Phase 146k (25 September 2026), so there are no
# Business Gateway details here. A person buys the official copy and records it on the property page.

# IONOS — sending email and calendar invites (Phase 146f)
IONOS_SMTP_HOST=
IONOS_SMTP_PORT=
IONOS_SMTP_USER=
IONOS_SMTP_PASSWORD=

# IONOS — reading replies to the contact@caprebate.co.uk mailbox (Phase 146f)
IONOS_IMAP_HOST=
IONOS_IMAP_PORT=
IONOS_IMAP_USER=
IONOS_IMAP_PASSWORD=

# Google Analytics 4 measurement id, G-XXXXXXXXXX. Not secret — it is printed in every page (Phase 146f)
GA4_MEASUREMENT_ID=

# Didit — the online identity check for the money-laundering rules, switched off (Phase 151f; Veriff until then)
# The webhook address to set in Didit's console is <the site's address>/hooks/identity-check.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=

# The key that seals each person's authenticator app secret in the database (Phase 151k). 32 random bytes, as base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Empty, the secret is kept as text, as before. Set, new secrets are sealed and old ones are read and then sealed.
# Keep a copy somewhere safe: without it, nobody with an app set up can sign in until their second step is reset.
CAPREBATE_MFA_KEY=

# Cloudflare Turnstile — the home page contact form's security check (29 September 2026), from the Cloudflare dashboard
# (Turnstile, add a widget for the site's address). The site key is not secret: it is printed in the page. Without the
# secret key, enquiries are not checked. Both are needed, and Cloudflare must also be approved in src/connectors/sources.ts
# (the data protection officer's decision) before anything is checked.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Zoom — video calls (30 September 2026): a meeting made for each video call, and joined inside our own pages. Two apps,
# both made in the Zoom App Marketplace (marketplace.zoom.us, Develop, Build App) while signed in to OUR Zoom account:
#   1. a Server-to-Server OAuth app — its account id, client id and client secret. Scopes: meeting:write:meeting:admin,
#      meeting:update:meeting:admin, meeting:delete:meeting:admin and user:read:token:admin (the host's start token).
#      Activate it.
#   2. a General app with the Meeting SDK turned on — its client id and client secret.
# The host is ZOOM_HOST_EMAIL (empty means the account's owner). Calls are booked for an hour; on a free Zoom plan a
# meeting stops at 40 minutes, which is accepted for testing (30 Sep 2026). The transfer to Zoom was approved for
# testing on 30 September 2026 (sources.ts, ZOOM_OAUTH and ZOOM_API).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=
ZOOM_HOST_EMAIL=

# WhatsApp — each client's messages from the back office (30 September 2026), through Meta's WhatsApp Cloud API. In Meta
# Business Suite: a WhatsApp Business account with our number; in Meta for Developers: an app with the WhatsApp product.
#   ACCESS_TOKEN      a system user's permanent token with whatsapp_business_messaging (Business settings, System users)
#   PHONE_NUMBER_ID   the id of our number (WhatsApp Manager, API setup) - not the number itself
#   APP_SECRET        the app's secret (App settings, Basic): it signs what Meta sends to us
#   VERIFY_TOKEN      a word we choose; type the same word into the app's webhook settings, with the address
#                     <our site>/hooks/whatsapp, and subscribe to "messages"
#   OPENING_TEMPLATE  the name of our approved "utility" template, one {{1}} for the first name, asking them to reply
#   TEMPLATE_LANGUAGE the template's language code; en_GB if empty
# Meta keeps messages outside the UK, so the data protection officer approves the transfer in
# src/connectors/sources.ts (WHATSAPP_CLOUD) before anything is sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OPENING_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=

# GoAddress — "Find my address" at the assessment (30 September 2026): a postcode to the list of addresses there, so the
# person picks theirs instead of typing it. From the GoAddress portal (goaddress.io): sign up, then copy the live API
# token. 100 lookups are free; paid plans count lookups a day. Only the postcode is sent.
GOADDRESS_API_KEY=

# Ordnance Survey (2 October 2026): the building outlines for the survey report's site plan. Free: sign up at
# osdatahub.os.uk on the OS OpenData plan, make a project, add the OS Features API to it, and copy the project key.
# Only a small square of map round the property's postcode is asked for, never a name or an address.
OS_DATA_HUB_API_KEY=

# The reply timer (1 October 2026): a free outside timer (cron-job.org) wakes the website every few minutes to read email
# replies, so they arrive with nobody on the site. It calls /hooks/read-replies with the header
# "Authorization: Bearer <this word>". Make one: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REPLY_TIMER_TOKEN=
