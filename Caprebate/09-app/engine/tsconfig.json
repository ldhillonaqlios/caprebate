{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",

    /* THE POINT OF THIS FILE. The engine's whole discipline is that an unknown
       fact stays unknown; a type system that lets `undefined` masquerade as a
       number is the fastest way to break non-negotiable N4. */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    /* src/calculator/*.js is the calculator's source, and it is also the
       text the site page carries (npm run page), so it stays plain sloppy-mode
       JavaScript the page can run as it is. It is typed from the outside by
       the hand-written .d.ts beside each file, and those ARE checked under
       every flag above. See EXTRACTION.md. */
    "allowJs": true,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
